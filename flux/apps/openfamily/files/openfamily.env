# Non-secret OpenFamily API configuration.
# Rendered into the `openfamily-config` ConfigMap by configMapGenerator and
# injected into the Deployment with envFrom. Anything secret (DATABASE_URL,
# JWT_SECRET, PLATFORM_ADMIN_PASSWORD) lives in the SOPS secret
# flux/infra/secrets/openfamily-secrets.yml instead.
#
# The API listens on plain HTTP and is reached through the cloudflared tunnel,
# which terminates TLS at Cloudflare: TLS_BEHIND_PROXY=true is what tells the
# API to accept cleartext on the pod network.
HTTP_ADDR=:8080
APP_ENV=production
TLS_BEHIND_PROXY=true

# Public identity. APP_ENV=production makes the server refuse to start on
# insecure defaults and enables its live DNS/HTTPS self-checks.
SITE_ADDRESS=openfamily.tartarus.us
PUBLIC_BASE_URL=https://openfamily.tartarus.us
ALLOWED_ORIGIN=https://openfamily.tartarus.us

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Push payloads omit the tracked member's name by default.
VERBOSE_PUSH=false

# UnifiedPush/ntfy is intentionally left unset: NTFY_BASE_URL would have to
# point at ntfy.tartarus.us, whose auth-default-access is deny-all with only
# anonymous *write* on up* topics -- subscribers need read. Android push stays
# off until an ntfy access rule exists for this app.
#
# Android APK cache served from the admin panel. Cached release APKs live on
# the QNAP NFS volume; iOS/APNs and Twilio SMS stay disabled.
APK_DIR=/data/apk
APK_GITHUB_REPO=wheresfrank/openfamily

# Bootstraps the first platform admin and CLOSES open registration (new family
# members then need an invite code). Idempotent on every restart. The matching
# password is PLATFORM_ADMIN_PASSWORD in openfamily-secrets.
PLATFORM_ADMIN_EMAIL=openfamily.admin@mail.bckr.me

# Self-update is disabled (no updater sidecar under Kubernetes): no
# UPDATER_URL/UPDATER_TOKEN. DEPLOY_REF_FILE points at an emptyDir so the admin
# panel reports "unknown" instead of erroring on a missing path.
DEPLOY_REF_FILE=/data/deploy/deployed-ref
