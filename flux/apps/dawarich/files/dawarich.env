# Non-secret Dawarich configuration. Rendered into the `dawarich-config`
# ConfigMap by configMapGenerator and injected with envFrom. Secrets
# (SECRET_KEY_BASE, DATABASE_PASSWORD) live in
# flux/infra/secrets/dawarich-secrets.yml.
#
# Full reference: https://dawarich.app/docs/self-hosting/environment-variables/

RAILS_ENV=production
SELF_HOSTED=true
RAILS_LOG_TO_STDOUT=true

# Public identity. APPLICATION_HOSTS takes bare hostnames (no scheme, no port);
# APPLICATION_PROTOCOL=HTTPS is what tells Rails it is behind a TLS proxy
# (cloudflared terminates TLS at Cloudflare). DOMAIN is required in production
# so absolute URLs in outgoing email resolve.
APPLICATION_HOSTS=dawarich.tartarus.us
APPLICATION_PROTOCOL=https
DOMAIN=dawarich.tartarus.us

TIME_ZONE=America/Puerto_Rico
DISTANCE_UNIT=km
# Store reverse-geocoded country/city data in PostGIS.
STORE_GEODATA=true

# Database: the dedicated `dawarich` CloudNativePG cluster (PostgreSQL 18 +
# PostGIS, reached through its -rw service). The password is in the secret.
DATABASE_HOST=dawarich-rw.cloudnative-pg.svc.cluster.local
DATABASE_PORT=5432
DATABASE_NAME=dawarich
DATABASE_USERNAME=dawarich

# Redis: the cluster's shared Bitnami Redis (auth disabled). Harbor already
# uses db 0, so Dawarich gets its own databases: cache=3, Sidekiq queue=4,
# WebSocket=5. Queued jobs live here, so a Redis restart loses in-flight
# imports/geocoding (they can be re-queued from the UI).
REDIS_URL=redis://redis-master.redis.svc.cluster.local:6379
RAILS_CACHE_DB=3
RAILS_JOB_QUEUE_DB=4
RAILS_WS_DB=5

# Background jobs inside the web process (upstream default since 1.17.0):
# one Deployment instead of a web+worker pair. WEB_CONCURRENCY must stay 0 so
# the embedded Sidekiq shares the single web process.
SIDEKIQ_EMBEDDED=true
WEB_CONCURRENCY=0
BACKGROUND_PROCESSING_CONCURRENCY=2

# /metrics on :9394 (Sidekiq metrics included). Nothing scrapes it yet; wire a
# ServiceMonitor in flux/infra/prometheus-operator when the dashboards are added.
PROMETHEUS_EXPORTER_ENABLED=true
