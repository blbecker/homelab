      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (code) (rate(traefik_service_requests_total{exported_service=~\"$service\"}[$interval]))",
          "instant": false,
          "legendFormat": "{{code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests by status code",
