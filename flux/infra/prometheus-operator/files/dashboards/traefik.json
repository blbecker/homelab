      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(10, label_replace(sum by (exported_service) (rate(traefik_service_requests_total{exported_service=~\"$service\"}[$interval])), \"svc\", \"$1\", \"exported_service\", \"httproute-([^-]+)-.*\"))",
          "instant": false,
          "legendFormat": "{{svc}}",
          "range": true,
