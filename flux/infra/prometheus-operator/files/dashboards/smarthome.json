                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    date_bin_gapfill(INTERVAL '5 minutes', time) AS time,\n    \"deviceName\" AS metric,\n    interpolate(avg(value)) AS temperature\nFROM temperature\nWHERE $__timeFilter(time)\nGROUP BY date_bin_gapfill(INTERVAL '5 minutes', time), \"deviceName\"\nORDER BY time",
