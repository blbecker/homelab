{
  "plugins": {
    "enabled": true,
    "allow": ["matrix"]
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "https://continuwuity.tartarus.us",
      "accessToken": "${MATRIX_ACCESS_TOKEN}",
      "dm": { "allowFrom": ["@benjamin:bckr.me"] },
      "groupPolicy": "allowlist",
      "encryption": true,
      "groups": {
        "!general:bckr.me": { "allow": true }
      },
      "groupAllowFrom": ["@benjamin:bckr.me"]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v3.2",
        "fallbacks": [
          "openrouter/deepseek/deepseek-v3.1",
          "openrouter/qwen/qwen3-235b-a22b-2507"
        ]
      },
      "heartbeat": {
        "every": "4h",
        "target": "last",
        "directPolicy": "allow",
        "lightContext": true,
        "activeHours": { "start": "10:00", "end": "23:00" },
        "model": "openrouter/qwen/qwen3-235b-a22b-2507",
        "includeReasoning": false
      },
      "models": {
        "openrouter/deepseek/deepseek-v3.2": { "alias": "main" },
        "openrouter/google/gemini-3-flash": { "alias": "flash" },
        "openrouter/deepseek/deepseek-v3.1": { "alias": "ds" },
        "openrouter/deepseek/deepseek-chat-v3.1": { "alias": "chat" },
        "openrouter/qwen/qwen3-235b-a22b-2507": { "alias": "qwen" }
      },
      "subagents": {
        "model": "openrouter/deepseek/deepseek-v3.1",
        "maxConcurrent": 4,
        "archiveAfterMinutes": 60
      },

      "imageModel": {
        "primary": "openrouter/google/gemini-3-flash"
      },

      "contextTokens": 200000
    }
  }
}
