{
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}",
    "cors_origins": ["*"]
  },
  "storage": {
    "workspace": "./data",
    "agfs": { "backend": "local" },
    "vectordb": { "backend": "local" }
  },
  "embedding": {
    "dense": {
      "api_base": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}",
      "provider": "openai",
      "dimension": 4096,
      "model": "qwen/qwen3-embedding-8b"
    }
  },
  "vlm": {
    "api_base": "https://openrouter.ai/api/v1",
    "api_key": "${OPENROUTER_API_KEY}",
    "provider": "openai",
    "model": "deepseek/deepseek-v3.2"
  }
}