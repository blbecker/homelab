{
  "plugins": {
    "enabled": true,
    "allow": ["matrix", "brave"],
    "entries": {
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${BRAVE_API_TOKEN}",
            "mode": "web"
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "brave",
        "maxResults": 5,
        "timeoutSeconds": 30
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": { "enabled": true },
        "bootstrap-extra-files": { "enabled": true },
        "session-memory": { "enabled": true },
        "command-logger": { "enabled": true }
      }
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "https://continuwuity.tartarus.us",
      "dm": { "allowFrom": ["@benjamin:bckr.me"] },
      "deviceName": "OpenClaw Gateway",
      "groupPolicy": "allowlist",
      "encryption": true,
      "groups": {
        "#general:bckr.me": { "requireMention": true },
        "#FamilyRoom:bckr.me": { "requireMention": true }
      },
      "groupAllowFrom": ["@benjamin:bckr.me"],

      "autoJoin": "allowlist",
      "autoJoinAllowlist": ["#general:bckr.me", "#FamilyRoom:bckr.me"],
      "threadReplies": "inbound",
      "replyToMode": "off",
      "streaming": "off"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v3.2",
        "fallbacks": [
          "openrouter/deepseek/deepseek-chat-v3.1",
          "openrouter/qwen/qwen3.5-flash-02-23"
        ]
      },
      "memorySearch": {
        "provider": "openai",
        "model": "qwen/qwen3-embedding-8b",
        "remote": {
          "baseUrl": "https://openrouter.ai/api/v1/",
          "apiKey": "${OPENROUTER_API_KEY}"
        }
      },
      "heartbeat": {
        "every": "1h",
        "target": "last",
        "directPolicy": "allow",
        "lightContext": true,
        "model": "openrouter/qwen/qwen3.5-flash-02-23",
        "includeReasoning": false,
        "isolatedSession": true
      },
      "imageModel": {
        "primary": "openrouter/qwen/qwen3.5-flash-02-23"
      },
      "imageGenerationModel": {
        "primary": "openrouter/google/gemini-3.1-flash-image-preview"
      },
      "models": {
        "openrouter/deepseek/deepseek-v3.2": { "alias": "main" },
        "openrouter/google/gemini-3-flash": { "alias": "flash" },
        "openrouter/qwen/qwen3.5-9b": { "alias": "qwen" }
      },
      "subagents": {
        "model": "openrouter/deepseek/deepseek-v4-flash",
        "maxConcurrent": 4,
        "archiveAfterMinutes": 60
      },
      "contextTokens": 150000
    }
  }
}
