{
  "gateway": {
    "controlUi": {
      "allowInsecureAuth": true
    }
  },
  "plugins": {
    "enabled": true,
    "allow": ["matrix", "brave"],
    "entries": {
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${BRAVE_API_TOKEN}",
            "mode": "web"
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "brave",
        "maxResults": 5,
        "timeoutSeconds": 30
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": { "enabled": true },
        "bootstrap-extra-files": { "enabled": true },
        "session-memory": { "enabled": true },
        "command-logger": { "enabled": true }
      }
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "homeserver": "https://continuwuity.tartarus.us",
      "accessToken": "${MATRIX_ACCESS_TOKEN}",
      "dm": { "allowFrom": ["@rachel:bckr.me"] },
      "deviceName": "OpenClaw Gateway",

      "groupPolicy": "allowlist",
      "encryption": true,
      "groups": {
        "#general:bckr.me": { "requireMention": true },
        "#FamilyRoom:bckr.me": { "requireMention": true },
        "#GraceLutheranChurch:bckr.me": { "requireMention": false },
        "#SoundHealing:bckr.me": { "requireMention": false },
        "#CAC:bckr.me": { "requireMention": false }
      },
      "groupAllowFrom": ["@rachel:bckr.me"],

      "autoJoin": "allowlist",
      "autoJoinAllowlist": [
        "#general:bckr.me",
        "#FamilyRoom:bckr.me",
        "#GraceLutheranChurch:bckr.me",
        "#SoundHealing:bckr.me",
        "#CAC:bckr.me"
      ],
      "threadReplies": "inbound",
      "replyToMode": "off",
      "streaming": "off"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v3.2",
        "fallbacks": [
          "openrouter/deepseek/deepseek-chat-v3.1",
          "openrouter/qwen/qwen3.5-9b"
        ]
      },
      "memorySearch": {
        "provider": "openai",
        "model": "qwen/qwen3-embedding-8b",
        "remote": {
          "baseUrl": "https://openrouter.ai/api/v1/",
          "apiKey": "${OPENROUTER_API_KEY}"
        }
      },
      "heartbeat": {
        "every": "1h",
        "target": "last",
        "directPolicy": "allow",
        "lightContext": true,
        "model": "openrouter/qwen/qwen3.5-9b",
        "includeReasoning": false
      },
      "models": {
        "openrouter/deepseek/deepseek-v3.2": { "alias": "main" },
        "openrouter/google/gemini-3-flash": { "alias": "flash" },
        "openrouter/deepseek/deepseek-chat-v3.1": { "alias": "chat" },
        "openrouter/qwen/qwen3.5-9b": { "alias": "qwen" }
      },
      "subagents": {
        "model": "openrouter/deepseek/deepseek-v3.2",
        "maxConcurrent": 4,
        "archiveAfterMinutes": 60
      },

      "imageGenerationModel": {
        "primary": "openrouter/google/gemini-2.5-flash-image"
      },

      "contextTokens": 200000
    }
  }
}
